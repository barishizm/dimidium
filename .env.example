# Copy this file to .env and fill in the values. Never commit .env.
# Every service below is optional until the feature that needs it is built.

# --- App -----------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Public HTTPS base URL of this app (e.g. an ngrok URL during local tests). OpenAI sends the
# incoming-call webhook to PUBLIC_BASE_URL/openai/webhook.
PUBLIC_BASE_URL=http://localhost:8000
# SQLite file for call logs, transcripts and messages for the owner.
DB_PATH=data/dimidium.db
# Seconds to wait for the owner's Telegram decision before taking a message.
HOLD_TIMEOUT_SECONDS=75
# Your name, used in the agent's instructions and Telegram texts. Callers never hear it: the
# agent says "the phone's owner" unless the caller names you first.
OWNER_NAME=
# Private details the agent must never say, comma-separated (street, district, workplace,
# family names...). Checked in code on the agent's transcript; OWNER_PHONE_NUMBER is always
# included. Prefer short distinctive words ("Žvėrynas, Vytauto") over a full address line.
PRIVATE_TERMS=
# Call-screening rules (known numbers, keyword rules). Copy rules.example.yaml to rules.yaml.
RULES_PATH=rules.yaml
# Transcripts older than this many days are deleted by a daily cleanup (call rows, summaries and
# messages are kept). Raw audio is never stored.
RETENTION_DAYS=30
# What callers get when you set /mode to "off": voicemail (the agent takes a message, nothing is
# pushed to Telegram, read it later with /messages) or reject (busy signal, the agent never answers).
OFF_MODE_ACTION=voicemail

# --- Post-call summary ---------------------------------------------------
# A separate, cheap model call after the call has ended (Turkish report for Telegram).
# openai (default): the Responses API with OPENAI_API_KEY, stored nowhere (store=false).
# anthropic: Claude with ANTHROPIC_API_KEY (pip install -e ".[anthropic]").
SUMMARY_PROVIDER=openai
# Empty = LIVE_BACKEND_MODEL (openai) or claude-haiku-5-5 (anthropic).
SUMMARY_MODEL=
SUMMARY_TIMEOUT_SECONDS=30
# Only for SUMMARY_PROVIDER=anthropic. Key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- OpenAI GPT-Live (voice + backend) -----------------------------------
# Project API key from https://platform.openai.com -> Settings -> Project -> API keys.
# The project needs billing (GPT-Live is not available on the Free tier). Check with:
#   python scripts/live_smoke.py --audio <file>
OPENAI_API_KEY=
# Voice model that talks to the caller.
LIVE_VOICE_MODEL=gpt-live-1
# Responses model GPT-Live delegates decisions and function calls to.
LIVE_BACKEND_MODEL=gpt-6-luna
# none | minimal | low | medium | high | xhigh. Low keeps phone latency down.
LIVE_BACKEND_REASONING_EFFORT=low
# Optional: auto | default | flex | priority. Leave empty for the project default.
LIVE_BACKEND_SERVICE_TIER=
# GPT-Live voice name (fixed for the whole call).
LIVE_VOICE=marin
# Lithuanian opening line with the AI disclosure and recording notice. Empty = built-in default.
LIVE_GREETING=

# --- GPT-Live SIP calls (docs/SETUP_SIP.md) ---------------------------------
# Project ID (proj_...) from Settings -> Project -> General. The Twilio trunk's origination
# URI is sip:<this>@sip.api.openai.com;transport=tls. Check with: python scripts/check_sip.py
OPENAI_PROJECT_ID=
# Signing secret (whsec_...) of the project webhook for live.transport.incoming, shown once
# when the webhook is created. Without it every incoming call is refused.
OPENAI_WEBHOOK_SECRET=
# Timeout for accept / reject / hangup requests (seconds).
LIVE_CONTROL_TIMEOUT_SECONDS=10
# The AI + recording disclosure must appear in the agent's speech within this time, or the
# app makes the agent say it.
LIVE_DISCLOSURE_DEADLINE_SECONDS=10
# After end_call: hang up once the agent has been quiet this long (goodbye finished), at the
# latest after LIVE_GOODBYE_MAX_SECONDS.
LIVE_GOODBYE_QUIET_SECONDS=1.5
LIVE_GOODBYE_MAX_SECONDS=10
# After an unrecoverable backend/sideband problem the caller gets this long to leave a message.
LIVE_FALLBACK_GRACE_SECONDS=30

# --- Telegram (owner channel) -------------------------------------------
# Bot token from @BotFather (/newbot), looks like 123456789:AA... Check with:
#   python scripts/check_telegram.py
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (a number). Press Start in your bot chat, then run
# scripts/check_telegram.py to print it. Only this chat is treated as the owner.
TELEGRAM_OWNER_CHAT_ID=

# --- Twilio (telephony) --------------------------------------------------
# Account SID and Auth Token from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number your calls are forwarded to, in E.164 format (e.g. +3705XXXXXXX). Calls
# from this number are rejected (forwarding loop), and the agent never says it.
TWILIO_PHONE_NUMBER=
# Your real mobile number (E.164). Never sent to the model and never spoken (checked in code).
OWNER_PHONE_NUMBER=

# --- Server and abuse limits ------------------------------------------------
# Port for `python -m app.serve` (the container). Render sets PORT itself.
PORT=8000
# On SIGTERM (deploy/restart), active calls get this long to hear "sorry, we have to end the
# call, I will pass everything on, goodbye". Keep it below the platform kill timeout.
SHUTDOWN_GRACE_SECONDS=20
# POST /openai/webhook requests per minute from one IP, and from all senders together
# (HTTP 429, checked before the signature).
WEBHOOK_REQUESTS_PER_IP_PER_MINUTE=60
WEBHOOK_REQUESTS_PER_MINUTE=300
# One number calling more often than this gets a busy signal (allowlisted numbers exempt).
CALLS_PER_CALLER=4
CALLS_PER_CALLER_WINDOW_SECONDS=600
# Calls answered at once; more ring busy.
MAX_CONCURRENT_CALLS=3

# --- Call flow ---------------------------------------------------------------
# Hard caps: the agent is told to wrap up WRAP_UP_SECONDS before MAX_CALL_SECONDS.
MAX_CALL_SECONDS=300
WRAP_UP_SECONDS=45
# While on hold the agent says "still trying" this often, at most HOLD_STILL_TRYING_MAX times
# (no hold music on SIP, see docs/HOLD_MUSIC.md).
HOLD_PHRASE_INTERVAL_SECONDS=20
HOLD_STILL_TRYING_MAX=3
# How often the agent may ask you (Telegram) during one call.
MAX_OWNER_QUESTIONS=2
