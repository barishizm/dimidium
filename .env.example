# Copy this file to .env and fill in the values. Never commit .env.
# Every service below is optional until the feature that needs it is built.

# --- App -----------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Public HTTPS base URL that Twilio can reach (e.g. an ngrok URL during local tests).
# WebSocket URLs are derived from this (https -> wss).
PUBLIC_BASE_URL=http://localhost:8000
# SQLite file for call logs, transcripts and messages for the owner.
DB_PATH=data/dimidium.db
# Seconds to wait for the owner's Telegram decision before taking a message.
HOLD_TIMEOUT_SECONDS=75
# How the agent refers to you when talking to callers (first name is fine, never a surname).
OWNER_NAME=
# Call-screening rules (known numbers, keyword rules). Copy rules.example.yaml to rules.yaml.
RULES_PATH=rules.yaml
# Transcripts older than this many days are deleted by a daily cleanup (call rows, summaries and
# messages are kept). Raw audio is never stored.
RETENTION_DAYS=30
# What callers get when you set /mode to "off": voicemail (the agent takes a message, nothing is
# pushed to Telegram, read it later with /messages) or reject (busy signal, the agent never answers).
OFF_MODE_ACTION=voicemail

# --- Anthropic (agent brain) --------------------------------------------
# API key from https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# Model used for the phone agent.
ANTHROPIC_MODEL=claude-haiku-5-5
# Reasoning effort: low | medium | high | xhigh | max. Low keeps phone latency down.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=2048
# Per-request timeout in seconds.
ANTHROPIC_TIMEOUT_SECONDS=20
# Let the API retry a refused request on a fallback model (true/false).
ANTHROPIC_REFUSAL_FALLBACK=true
# Post-call summary for Telegram: a separate, cheap model call after the call has ended.
SUMMARY_MODEL=claude-haiku-5-5
SUMMARY_TIMEOUT_SECONDS=30

# --- Telegram (owner channel) -------------------------------------------
# Bot token from @BotFather (/newbot), looks like 123456789:AA... Check with:
#   python scripts/check_telegram.py
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (a number). Press Start in your bot chat, then run
# scripts/check_telegram.py to print it. Only this chat is treated as the owner.
TELEGRAM_OWNER_CHAT_ID=

# --- Twilio (telephony) --------------------------------------------------
# Account SID and Auth Token from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number calls are forwarded to, in E.164 format (e.g. +3705XXXXXXX).
TWILIO_PHONE_NUMBER=
# Reject /twilio/voice requests without a valid X-Twilio-Signature (needs TWILIO_AUTH_TOKEN).
# Only set to false for local curl tests.
TWILIO_VALIDATE_SIGNATURE=true
# Your real mobile number (E.164). Only used for allowlisted callers (rules.yaml ->
# do_not_answer.allow with offer_forward: true): their ring alert gets a "📲 Telefonuma bağla"
# button that forwards the live call here via Twilio <Dial>. Empty = no forward button.
# Keep TWILIO_PHONE_NUMBER set too: it is the caller ID of the forward, which stops a loop when
# your phone diverts the forward back to Twilio.
OWNER_FORWARD_NUMBER=
# How long your phone rings before the agent takes a message instead.
FORWARD_RING_SECONDS=20

# --- Server and abuse limits ------------------------------------------------
# Port for `python -m app.serve` (the container). Render sets PORT itself.
PORT=8000
# On SIGTERM (deploy/restart), active calls get this long to hear "sorry, we have to end the
# call, I will pass everything on, goodbye". Keep it below the platform kill timeout.
SHUTDOWN_GRACE_SECONDS=20
# POST /twilio/voice requests per minute from one IP (checked before the signature).
VOICE_REQUESTS_PER_IP_PER_MINUTE=60
# One number calling more often than this gets a busy signal (allowlisted numbers exempt).
CALLS_PER_CALLER=4
CALLS_PER_CALLER_WINDOW_SECONDS=600
# Calls answered at once; more ring busy.
MAX_CONCURRENT_CALLS=3

# --- Call flow ---------------------------------------------------------------
# Hard caps: the agent is told to wrap up WRAP_UP_SECONDS before MAX_CALL_SECONDS.
MAX_CALL_SECONDS=300
MAX_CALLER_TURNS=30
WRAP_UP_SECONDS=45
# A filler phrase ("Minutėlę.") if the agent has said nothing this long after the caller.
FILLER_AFTER_SECONDS=2.0
MAX_FILLERS_PER_TURN=2
# "Ar jūs dar girdite mane?" after this much caller silence; the call ends after two.
CALLER_IDLE_SECONDS=12
# While on hold: music, plus "still trying" this often.
HOLD_PHRASE_INTERVAL_SECONDS=20
# Your own hold music file: 8 kHz mono mu-law, .wav or raw .ulaw (played quietly, looped).
# Empty = generated music. Make a starting file with: python scripts/make_hold_audio.py
HOLD_AUDIO_PATH=
# How often the agent may ask you (Telegram) during one call.
MAX_OWNER_QUESTIONS=2
# Turn detection: VAD silence before "stopped speaking", then the wait for more speech.
VAD_STOP_SECS=0.3
TURN_SPEECH_TIMEOUT=0.5
# Per-turn latency (end of speech -> first agent audio) above this is logged as a warning.
LATENCY_TARGET_MS=1200
# Pipecat's own log level. DEBUG logs transcripts and spoken text.
PIPECAT_LOG_LEVEL=WARNING

# --- Speech providers ----------------------------------------------------
# Speech-to-text provider: google | azure | deepgram
STT_PROVIDER=google
# Text-to-speech provider: google | azure | elevenlabs
TTS_PROVIDER=google
# Language settings for the caller side.
CALLER_LANGUAGE=lt-LT
FALLBACK_LANGUAGE=en-US
# Connect / first-response timeout for speech APIs, in seconds.
SPEECH_TIMEOUT_SECONDS=15
# Live-call STT languages (comma-separated). Empty = CALLER_LANGUAGE only. "lt-LT,en-US" asks
# the provider to auto-detect English callers (test it with your provider before relying on it).
STT_LANGUAGES=
# P99 seconds from end of speech to the final transcript (tunes turn detection).
STT_FINAL_P99_SECONDS=1.0
# A live TTS request with no audio after this long is retried once.
TTS_FIRST_BYTE_TIMEOUT_SECONDS=4.0
# Pre-synthesized greeting/filler/fallback audio is cached here (per provider and voice).
PHRASE_CACHE_DIR=data/phrase_cache
# Compare providers on Lithuanian phone audio:
#   python scripts/benchmark_speech.py --audio-dir samples/lt

# Google Cloud (Speech-to-Text v2 / Chirp + Text-to-Speech). pip install -e ".[google]"
# Path to a service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=
# Google Cloud project ID that has the Speech-to-Text and Text-to-Speech APIs enabled.
GOOGLE_CLOUD_PROJECT=
# Speech-to-Text v2 location. chirp_3 serves lt-LT in "eu"; chirp/chirp_2 in "europe-west4".
GOOGLE_STT_LOCATION=eu
GOOGLE_STT_MODEL=chirp_3
# lt-LT voices: lt-LT-Chirp3-HD-<Name> (streaming, e.g. Kore, Aoede, Charon, Puck) or
# lt-LT-Standard-B.
GOOGLE_TTS_VOICE=lt-LT-Chirp3-HD-Kore

# Azure AI Speech. pip install -e ".[azure]"
# Key and region from Azure Portal -> your Speech resource -> Keys and Endpoint.
AZURE_SPEECH_KEY=
# Region id, e.g. westeurope or northeurope.
AZURE_SPEECH_REGION=
# lt-LT-OnaNeural (female) or lt-LT-LeonasNeural (male).
AZURE_TTS_VOICE=lt-LT-OnaNeural

# Deepgram (speech-to-text only; nova-3 supports Lithuanian, Aura TTS does not).
# Key from https://console.deepgram.com -> API Keys.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ElevenLabs (text-to-speech only). Lithuanian needs eleven_v3 or eleven_v4 / eleven_v4_turbo.
# Key from https://elevenlabs.io -> Developers -> API Keys.
ELEVENLABS_API_KEY=
# Voice ID from the ElevenLabs voice library (Voices -> a voice -> copy ID).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
