# Copy this file to .env and fill in the values. Never commit .env.
# Every service below is optional until the feature that needs it is built.

# --- App -----------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Public HTTPS base URL that Twilio can reach (e.g. an ngrok URL during local tests).
# WebSocket URLs are derived from this (https -> wss).
PUBLIC_BASE_URL=http://localhost:8000
# SQLite file for call logs, transcripts and messages for the owner.
DB_PATH=data/dimidium.db
# Seconds to wait for the owner's Telegram decision before taking a message.
HOLD_TIMEOUT_SECONDS=75

# --- Anthropic (agent brain) --------------------------------------------
# API key from https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# Model used for the phone agent.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram (owner channel) -------------------------------------------
# Bot token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Your personal chat ID. Only messages from this chat are treated as the owner.
TELEGRAM_OWNER_CHAT_ID=

# --- Twilio (telephony) --------------------------------------------------
# Account SID and Auth Token from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number calls are forwarded to, in E.164 format (e.g. +3705XXXXXXX).
TWILIO_PHONE_NUMBER=

# --- Speech providers ----------------------------------------------------
# Which provider to use for speech-to-text and text-to-speech: google | azure
STT_PROVIDER=google
TTS_PROVIDER=google
# Language settings for the caller side.
CALLER_LANGUAGE=lt-LT
FALLBACK_LANGUAGE=en-US

# Google Cloud (Speech-to-Text v2 / Chirp + Text-to-Speech)
# Path to a service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=
# Google Cloud project ID that has the Speech and TTS APIs enabled.
GOOGLE_CLOUD_PROJECT=
# Region for Speech-to-Text v2 recognizers (e.g. europe-west4, eu, global).
GOOGLE_STT_LOCATION=eu

# Azure Speech
# Key and region from Azure Portal -> your Speech resource -> Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
